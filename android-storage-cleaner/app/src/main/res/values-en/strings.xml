    <string name="about_intro">Apexus Cleaner scans all of your phone’s storage, ranks folders by size and helps you free the space taken by junk files. Nothing is deleted without your consent.</string>
    <string name="about_limits_title">What Android lets an app clean</string>
    <string name="about_col_android8">Android 8–10</string>
    <string name="about_col_android11">Android 11+</string>
    <string name="about_cap_shared_files">Files in shared storage</string>
    <string name="about_cap_logs_traces">App logs and traces (shared storage)</string>
    <string name="about_cap_android_data">Android/data and Android/obb folders</string>
    <string name="about_cap_app_cache">Other apps’ caches</string>
    <string name="about_cap_system_logs">System logs (/data/log…) without root</string>
    <string name="about_cap_app_sizes">App sizes (usage access)</string>
    <string name="about_legend_yes">Possible</string>
    <string name="about_legend_assisted">Through Settings</string>
    <string name="about_legend_no">Not possible</string>
    <string name="about_system_explained">“System and other” is the space no app can measure: Android itself, system partitions, apps’ private data and protected areas. It is computed as total − free − everything measured.</string>
    <string name="about_privacy">Privacy: the app has no Internet access. No data ever leaves your device.</string>

    <string name="onboarding_1_title">See where your space goes</string>
    <string name="onboarding_1_text">Apexus Cleaner measures all of your storage and ranks folders and files from largest to smallest.</string>
    <string name="onboarding_2_title">Free the hidden space</string>
    <string name="onboarding_2_text">Logs, traces, caches, temporary files, duplicates, forgotten APKs… everything that fills your phone without you noticing.</string>
    <string name="onboarding_3_title">You stay in control</string>
    <string name="onboarding_3_text">You choose what gets deleted. A trash lets you restore your files for 7 days.</string>

    <string name="permissions_title">Permissions</string>
    <string name="permissions_intro">Here is the access Apexus Cleaner needs, and why. You can change it at any time in Android Settings.</string>
    <string name="permissions_continue_limited">Continue with limited features</string>
    <string name="permission_required">Required</string>
    <string name="permission_optional">Optional</string>
    <string name="permission_granted">Allowed</string>
    <string name="permission_files_title">All files access</string>
    <string name="permission_files_why">To measure every folder in the storage and delete the files you select.</string>
    <string name="permission_files_without">Without it, no scan is possible.</string>
    <string name="permission_usage_title">Usage access</string>
    <string name="permission_usage_why">To know each app’s size and cache, and when it was last used.</string>
    <string name="permission_usage_without">Without it, the Apps screen and cache measurement are unavailable.</string>
    <string name="permission_notif_title">Notifications</string>
    <string name="permission_notif_why">To let you know when the scheduled scan finds space to free.</string>
    <string name="permission_notif_without">Without it, the scheduled scan stays silent.</string>

