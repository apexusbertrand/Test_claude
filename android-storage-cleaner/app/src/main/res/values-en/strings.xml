    <string name="home_recoverable_none_safe">Nothing is risk-free: open “Clean” and check yourself what you agree to delete.</string>
    <string name="system_intro">This is what remains once free space, measured files and apps are subtracted. No app can see its details, but on most phones it is made of the items below.</string>
    <string name="system_contents_title">What this space is usually made of</string>
    <string name="system_size_variable">Varies</string>
    <string name="system_size_unknown">Unknown</string>
    <string name="system_item_os_title">Android and the manufacturer’s interface</string>
    <string name="system_item_os_size">12 to 18 GB</string>
    <string name="system_item_os_text">The read-only system itself. This is normal and cannot be reduced.</string>
    <string name="system_item_ramplus_title">RAM Plus (virtual memory)</string>
    <string name="system_item_ramplus_size">2 to 8 GB</string>
    <string name="system_item_ramplus_text">Samsung reserves part of the storage as extra RAM. To get it back: Device care › Memory › RAM Plus › Off, then restart.</string>
    <string name="system_item_trash_title">Gallery and Files trash</string>
    <string name="system_item_trash_text">Deleted photos, videos and files stay there for 30 days. Open the app, menu › Trash › Empty.</string>
    <string name="system_item_app_trash_title">Apexus Cleaner trash</string>
    <string name="system_item_app_trash_text">Now shown separately in the breakdown. Empty it if you no longer need to restore these items.</string>
    <string name="system_item_secure_title">Samsung Secure Folder</string>
    <string name="system_item_secure_text">Its content is encrypted and invisible to other apps. Clean it up from the Secure Folder itself.</string>
    <string name="system_item_temp_title">Updates and temporary files</string>
    <string name="system_item_temp_size">1 to 5 GB</string>
    <string name="system_item_temp_text">Downloaded system updates and Android temporary files. Restarting the phone often frees some of it.</string>
    <string name="system_item_protected_title">Protected folders</string>
    <string name="system_item_protected_text">%1$d folders could not be read during the scan (protected by Android). Their content is counted here.</string>
    <string name="system_realistic_title">What to expect</string>
    <string name="system_realistic_text">RAM Plus, the trash folders and a restart often free 5 to 10 GB. Below 15 to 18 GB, only the system itself remains.</string>
