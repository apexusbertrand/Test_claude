    <string name="permission_granted">Autorisé</string>
    <string name="permission_files_title">Accès à tous les fichiers</string>
    <string name="permission_files_why">Pour mesurer chaque dossier du stockage et supprimer les fichiers que vous sélectionnez.</string>
    <string name="permission_files_without">Sans cet accès, aucune analyse n’est possible.</string>
    <string name="permission_usage_title">Accès aux données d’utilisation</string>
    <string name="permission_usage_why">Pour connaître la taille et le cache de chaque application, et leur date de dernière utilisation.</string>
