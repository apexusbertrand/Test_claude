    <!-- À propos -->
    <string name="about_intro">StorageLens analyse tout le stockage de votre téléphone, classe les dossiers par taille et vous aide à libérer l’espace occupé par les fichiers inutiles. Rien n’est supprimé sans votre accord.</string>
    <string name="about_limits_title">Ce qu’Android permet de nettoyer</string>
    <string name="about_col_android8">Android 8–10</string>
    <string name="about_col_android11">Android 11+</string>
    <string name="about_cap_shared_files">Fichiers du stockage partagé</string>
    <string name="about_cap_logs_traces">Logs et traces des applications (stockage partagé)</string>
    <string name="about_cap_android_data">Dossiers Android/data et Android/obb</string>
    <string name="about_cap_app_cache">Cache des autres applications</string>
    <string name="about_cap_system_logs">Journaux système (/data/log…) sans root</string>
    <string name="about_cap_app_sizes">Taille des applications (accès aux données d’utilisation)</string>
    <string name="about_legend_yes">Possible</string>
    <string name="about_legend_assisted">Via les Paramètres</string>
    <string name="about_legend_no">Impossible</string>
    <string name="about_system_explained">« Système et autres » correspond à l’espace qu’aucune application ne peut mesurer : Android lui-même, les partitions système, les données privées des applications et les zones protégées. Il est calculé ainsi : total − libre − tout ce qui a été mesuré.</string>
    <string name="about_privacy">Confidentialité : l’application n’a pas accès à Internet. Aucune donnée ne quitte votre appareil.</string>

    <!-- Onboarding -->
    <string name="onboarding_1_title">Voyez où part votre espace</string>
    <string name="onboarding_1_text">StorageLens mesure tout votre stockage et classe dossiers et fichiers du plus volumineux au plus petit.</string>
    <string name="onboarding_2_title">Libérez l’espace caché</string>
    <string name="onboarding_2_text">Logs, traces, caches, fichiers temporaires, doublons, APK oubliés… tout ce qui remplit le téléphone sans que vous le voyiez.</string>
    <string name="onboarding_3_title">Vous gardez le contrôle</string>
    <string name="onboarding_3_text">Vous choisissez ce qui est supprimé. Une corbeille permet de restaurer vos fichiers pendant 7 jours.</string>

    <!-- Autorisations -->
    <string name="permissions_title">Autorisations</string>
    <string name="permissions_intro">Voici les accès dont StorageLens a besoin, et pourquoi. Vous pouvez les modifier à tout moment dans les Paramètres Android.</string>
    <string name="permissions_continue_limited">Continuer avec des fonctions limitées</string>
